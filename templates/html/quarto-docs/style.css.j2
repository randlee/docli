
:root {
  color-scheme: light;
  --bg: {{ theme.bg }};
  --fg: {{ theme.fg }};
  --sidebar-bg: {{ theme.sidebar_bg }};
  --sidebar-border: {{ theme.sidebar_border }};
  --accent: {{ theme.accent }};
  --accent-hover: {{ theme.accent_hover }};
  --muted: {{ theme.muted }};
  --header-bg: {{ theme.header_bg }};
  --code-bg: {{ theme.code_bg }};
  --header-h: 3.25rem;
  --sidebar-w: 16.5rem;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  font: {{ theme.font_body }};
  background: var(--bg);
  color: var(--fg);
}
.quarto-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: var(--header-bg);
  border-bottom: 1px solid var(--sidebar-border);
  height: var(--header-h);
}
.header-inner {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  height: 100%;
  padding: 0 1rem;
  max-width: 100%;
}
.quarto-btn-toggle {
  border: 1px solid var(--sidebar-border);
  background: var(--sidebar-bg);
  border-radius: 0.375rem;
  width: 2.25rem;
  height: 2.25rem;
  cursor: pointer;
  padding: 0;
  flex-shrink: 0;
}
.toggle-icon {
  display: block;
  width: 1.1rem;
  height: 0.85rem;
  margin: 0 auto;
  background: linear-gradient(var(--fg) 0 0) 0 0 / 100% 2px no-repeat,
    linear-gradient(var(--fg) 0 0) 0 50% / 100% 2px no-repeat,
    linear-gradient(var(--fg) 0 0) 0 100% / 100% 2px no-repeat;
  opacity: 0.75;
}
.quarto-page-breadcrumbs { flex: 1 1 auto; min-width: 0; overflow: hidden; }
.breadcrumb {
  display: flex;
  flex-wrap: wrap;
  list-style: none;
  margin: 0;
  padding: 0;
  font-size: 0.875rem;
  color: var(--muted);
  gap: 0.35rem;
}
.breadcrumb-item + .breadcrumb-item::before {
  content: "/";
  padding-right: 0.35rem;
  color: var(--muted);
}
.breadcrumb-item.active { color: var(--fg); font-weight: 500; }
.header-search {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
}
.search-label { color: var(--muted); white-space: nowrap; }
.header-search input {
  font: inherit;
  padding: 0.35rem 0.65rem;
  border: 1px solid var(--sidebar-border);
  border-radius: 0.375rem;
  min-width: 14rem;
  background: var(--bg);
  color: var(--fg);
}
#quarto-content {
  display: grid;
  grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
  padding-top: var(--header-h);
  min-height: 100vh;
}
#quarto-content.sidebar-collapsed {
  grid-template-columns: 0 minmax(0, 1fr);
}
#quarto-content.sidebar-collapsed #quarto-sidebar {
  visibility: hidden;
  overflow: hidden;
}
#quarto-sidebar {
  position: sticky;
  top: var(--header-h);
  align-self: start;
  height: calc(100vh - var(--header-h));
  overflow: auto;
  background: var(--sidebar-bg);
  border-right: 1px solid var(--sidebar-border);
  padding: 1rem 0.75rem 2rem;
}
.sidebar-header { padding: 0 0.5rem 0.75rem; border-bottom: 1px solid var(--sidebar-border); margin-bottom: 0.75rem; }
.sidebar-title { font-weight: 600; font-size: 1.05rem; line-height: 1.3; }
.sidebar-title a { color: var(--fg); text-decoration: none; }
.sidebar-title a:hover { color: var(--accent); }
.sidebar-version { margin: 0.35rem 0 0; font-size: 0.8rem; color: var(--muted); }
.sidebar-section-heading {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--muted);
  margin: 0 0.5rem 0.5rem;
  font-weight: 600;
}
.sidebar-menu { display: block; }
#tree ul { list-style: none; margin: 0; padding: 0; }
#tree .docli-caret, #tree .docli-cmd {
  border: 0;
  background: none;
  color: inherit;
  font: inherit;
  cursor: pointer;
  text-align: left;
}
#tree .docli-caret {
  width: 1rem;
  height: 1.5rem;
  padding: 0;
  color: var(--muted);
  vertical-align: middle;
}
#tree .docli-caret::before {
  content: "\25B6";
  display: inline-block;
  font-size: 0.55rem;
  transition: transform 0.15s ease;
}
#tree .node.open > .docli-caret::before { transform: rotate(90deg); }
#tree .node.leaf > .docli-caret { visibility: hidden; }
#tree .docli-cmd {
  display: inline-flex;
  align-items: center;
  width: calc(100% - 1.1rem);
  padding: 0.35rem 0.5rem;
  border-radius: 0.375rem;
  color: var(--fg);
}
#tree .docli-cmd:hover { background: rgba(39, 128, 227, 0.08); color: var(--accent-hover); }
#tree .docli-cmd[aria-current="true"] {
  background: var(--accent);
  color: #fff;
  font-weight: 500;
}
#tree .children {
  margin-left: 0.65rem;
  padding-left: 0.5rem;
  border-left: 1px solid var(--sidebar-border);
}
#tree .children[hidden] { display: none; }
#tree .hidden { display: none; }
#docli-search-status { font-size: 0.85rem; color: var(--muted); padding: 0 0.5rem; }
.content {
  padding: 1.75rem 2.5rem 3rem;
  max-width: 52rem;
}
.quarto-body .card {
  margin-bottom: 1.75rem;
}
.quarto-body .card:first-child {
  border-bottom: 1px solid var(--sidebar-border);
  padding-bottom: 1.25rem;
}
.quarto-body .card h2 {
  font: {{ theme.font_title }};
  margin: 0 0 0.75rem;
  font-weight: 600;
}
.quarto-body .card h3 {
  font-size: 1rem;
  font-weight: 600;
  margin: 1.25rem 0 0.5rem;
  color: var(--fg);
}
.quarto-body .card p { margin: 0.5rem 0; line-height: 1.65; }
pre.usage {
  background: var(--code-bg);
  border: 1px solid var(--sidebar-border);
  border-left: 4px solid var(--accent);
  padding: 0.85rem 1rem;
  border-radius: 0.375rem;
  overflow-x: auto;
  margin: 0.5rem 0 0;
  font-size: 0.9rem;
}
table {
  border-collapse: collapse;
  width: 100%;
  font-size: 0.9rem;
  margin-top: 0.5rem;
}
th, td {
  border: 1px solid var(--sidebar-border);
  padding: 0.45rem 0.6rem;
  text-align: left;
  vertical-align: top;
}
th {
  background: var(--sidebar-bg);
  font-weight: 600;
  font-size: 0.8rem;
}
.meta, #docli-status { color: var(--muted); font-size: 0.9rem; }
code { font-size: 0.88em; }
@media (max-width: 900px) {
  #quarto-content { grid-template-columns: 1fr; }
  #quarto-sidebar {
    position: fixed;
    left: 0;
    top: var(--header-h);
    width: min(var(--sidebar-w), 88vw);
    z-index: 900;
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.12);
  }
  #quarto-content.sidebar-collapsed #quarto-sidebar { transform: translateX(-110%); visibility: visible; }
  .content { padding: 1.25rem 1rem 2rem; }
  .header-search input { min-width: 0; width: 8rem; }
}
