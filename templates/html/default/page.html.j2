<!doctype html>
<html lang="en" id="docli-default-pack">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title|docli_escape }} CLI Reference</title>
<style>{{ style }}</style>
</head>
<body>
<header><a class="crumb" href="../">Documentation</a><h1>{{ title|docli_escape }} CLI Reference</h1>{% if version %}<span class="meta">Version {{ version|docli_escape }}</span>{% endif %}<label class="search">Search <input id="search" type="search" autocomplete="off" placeholder="commands and options"></label></header>
<main>
<aside class="pane"><h2>Commands</h2><nav id="tree">{{ tree }}</nav></aside>
<article class="pane" id="detail" aria-live="polite"></article>
</main>
<script id="docli-data" type="application/json">{{ model_json }}</script>
<script id="docli-search" type="application/json">{{ search_json }}</script>
<script>
{{ script }}
</script>
</body>
</html>
