  triage:promoteTo <urn:atm:triage:worktree/integrate-phase-d/608c413> ;
  triage:triagedAt "2026-10-13T08:21:00Z"^^xsd:dateTime .

<urn:atm:triage:occurrence/M1/code/1>
  a triage:Occurrence ;
  triage:file "src/ops.rs" ;
  triage:line 854 ;
  triage:snippet "fn release_tool_dll(repo: &Path) -> Result<PathBuf, ErrorBody> { let csproj = repo.join(\"dotnet/src/Docli.Tool/Docli.Tool.csproj\"); let tfm = tool_target_framework(&csproj)?; Ok(repo.join(\"dotnet/src/Docli.Tool/bin/Release\").join(tfm).join(\"Docli.Tool.dll\")) }" ;
  triage:status "open" ;
  triage:closed false ;
  triage:branch "integrate/phase-d" ;
