<urn:atm:triage:finding/M1>
  a triage:Finding ;
  triage:findingId "M1" ;
  triage:title "TFM string in DLL path" ;
  triage:description "tool_target_framework() parses the TargetFramework XML element from the .csproj file and embeds it as a path component to locate the Release DLL: repo/dotnet/src/Docli.Tool/bin/Release/<tfm>/Docli.Tool.dll. This is fragile: the TFM in the csproj is the single source of truth for the path, but any mismatch between that declaration and the actual build artifact is silent until the file probe fails. No validation records what TFM was expected vs. what was built." ;
  triage:phaseId "phase-d" ;
  triage:triageMode "initial_pass" ;
  triage:repeatable false ;
  triage:sweepScope "file_only" ;
  triage:status "open" ;
  triage:dispatchReady true ;
  triage:category "M" ;
  triage:severity "minor" ;
  triage:requirementId "REQ-DOCLI-NET-002" ;
  triage:adrId "ADR-005" ;
  triage:originatingSprintDoc "docs/plans/phase-d/d6-generate-docli-dotnet.md" ;
  triage:hasOccurrence <urn:atm:triage:occurrence/M1/code/1> ;
