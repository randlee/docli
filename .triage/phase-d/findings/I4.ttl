<urn:atm:triage:finding/I4>
  a triage:Finding ;
  triage:findingId "I4" ;
  triage:title "No CLI/subprocess timeout; stderr truncated to 240 chars" ;
  triage:description "run_dotnet_project() calls output() without a timeout. Stderr is truncated by one_line() to the first newline only, losing diagnostic context. The .NET subprocess or a hanging process has no deadline. Phase D host gate and tests have timeout constraints (d.6 PR timeouts 180s for build+run), but no runtime timeout is enforced in production." ;
  triage:phaseId "phase-d" ;
  triage:triageMode "initial_pass" ;
