      "required": true,
      "default_value": "out.json",
      "choices": ["json", "yaml"],
      "min_values": 1,
      "max_values": 2,
      "vendor_opt": "opt-extra"
    }
  ],
  "arguments": [
    {
      "name": "file",
      "help": "Input file",
      "required": true,
      "default_value": "input.txt",
      "choices": ["input.txt", "other.txt"],
      "vendor_arg": "arg-extra"
    }
  ],
  "subcommands": [
    {
      "name": "run",
      "vendor_sub": "sub-extra"
    }
  ]
}
