{
  "name": "demo",
  "version": "2.1.0",
  "description": "All-fields demo",
  "long_description": "Every schema field except extra.",
  "epilogue": "End of the all-fields command.",
  "usage": "demo --output <PATH> <file>",
  "vendor_root": "root-extra",
  "options": [
    {
      "name": "output",
      "long": "--output",
      "short": "-o",
